  "item": [
    {
      "name": "Stock Tracker API",
      "item": [
        {
          "name": "Register - Success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueId = Date.now();\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"testUsername\",\r",
                  "    `postman_user_${uniqueId}`\r",
                  ");\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"testEmail\",\r",
                  "    `postman_${uniqueId}@example.com`\r",
                  ");\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"testPassword\",\r",
                  "    \"Test1234!\"\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Register returns 201\", () => {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", () => {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Password is not returned\", () => {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response).not.to.have.property(\"password\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"user_name\": \"{{testUsername}}\",\r\n  \"password\": \"{{testPassword}}\",\r\n  \"email\": \"{{testEmail}}\",\r\n  \"phone_number\": \"0501234567\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8000/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
