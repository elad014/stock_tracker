# Use the direct Neon endpoint, not the -pooler one: the pooler rejects the
# search_path startup parameter the database client sends.
DATABASE_URL=postgresql://ui_db_user:password@host/neondb?sslmode=require&channel_binding=require
DB_SCHEMA=ui_schema
# 32 random bytes, base64url-encoded without padding. Required by JWE dir+A256GCM.
# python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
JWT_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
STOCK_SERVICE_URL=http://localhost:8001
NEWS_SERVICE_URL=http://localhost:8003
DOC_SERVICE_URL=http://localhost:8004
CHAT_SERVICE_URL=http://localhost:8002
INTERNAL_API_KEY=my-secret-key

# Supabase Storage over the S3 protocol.
# Endpoint, region and keys come from Storage Settings > S3 access keys.
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_USER_DOCUMENTS=users_personal_documents
MAX_FILES_PER_USER=10
MAX_UPLOAD_BYTES=20971520
