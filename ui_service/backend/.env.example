DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET_KEY=change_me_to_a_random_secret
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
STOCK_MANAGER_URL=http://localhost:8001
NEWS_AGENT_URL=http://localhost:8003
INTERNAL_API_KEY=my-secret-key

# Supabase Storage over the S3 protocol.
# Endpoint, region and keys come from Storage Settings > S3 access keys.
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_USER_DOCUMENTS=users_personal_documents
MAX_FILES_PER_USER=10
MAX_UPLOAD_BYTES=20971520
