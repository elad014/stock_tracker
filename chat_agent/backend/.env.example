INTERNAL_API_KEY=change-me
# LiteLLM model ids MUST include the provider prefix. Tried in order on 503 / high demand.
# Examples: gemini/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-latest
LLM_MODELS=gemini/gemini-2.5-flash,gemini/gemini-2.5-flash-lite
LLM_MAX_TOKENS=2048
LLM_SYSTEM_PROMPT=
LLM_SESSION_MAX_MESSAGES=20
STOCK_MANAGER_URL=http://localhost:8001
NEWS_AGENT_URL=http://localhost:8003
DOC_AGENT_URL=http://localhost:8004
# Provider key(s) — match the vendors in LLM_MODELS
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
