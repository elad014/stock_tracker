INTERNAL_API_KEY=my-secret-key
# Use the direct Neon endpoint, not the -pooler one: the pooler rejects the
# search_path startup parameter the database client sends.
DATABASE_URL=
# public stays on the path so the pgvector type and the <=> operator resolve.
DB_SCHEMA=doc_schema,public

# Supabase Storage over the S3 protocol (same bucket ui-service writes to).
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_USER_DOCUMENTS=users_personal_documents

EMBEDDING_MODEL=gemini/gemini-embedding-001
LLM_MODELS=gemini/gemini-2.5-flash,gemini/gemini-2.5-flash-lite
LLM_MAX_TOKENS=2048
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
