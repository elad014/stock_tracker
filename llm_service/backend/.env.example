INTERNAL_API_KEY=change-me
# LiteLLM model id MUST include the provider prefix
# Examples: gemini/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-latest
LLM_MODEL=gemini/gemini-2.5-flash
LLM_MAX_TOKENS=2048
LLM_SYSTEM_PROMPT=You are a financial news analyst. Only answer finance-related questions.
LLM_SESSION_MAX_MESSAGES=20
# Provider key(s) — match the vendor in LLM_MODEL
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
