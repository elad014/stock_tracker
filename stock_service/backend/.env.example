# Use the direct Neon endpoint, not the -pooler one: the pooler rejects the
# search_path startup parameter the database client sends.
DATABASE_URL=
DB_SCHEMA=stock_schema
TWELVEDATA_API_KEY=
INTERNAL_API_KEY=change-me
HISTORY_RETENTION_YEARS=5
DAILY_CRON=0 * * * *
CLEANUP_CRON=0 0 * * *
SCHEDULER_TIMEZONE=Asia/Jerusalem
